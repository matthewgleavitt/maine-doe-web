  <page id="591">
    <name>Outlook &amp; Email Guidelines</name>
    <intro>&lt;p&gt;&lt;img class="img-fluid" role="presentation" src="@@PLUGINFILE@@/Branding%20-%20Email.png" alt="" width="1575" height="300"&gt;&lt;/p&gt;
&lt;h6&gt;&lt;img class="img-fluid" style="float: left; padding-right: 10px;" role="presentation" src="@@PLUGINFILE@@/Email.png" alt="" width="100" height="100"&gt;&lt;em&gt;Ensuring that our branding is consistent across communications platforms, including email, is important to creating our brand, which, in turn, promotes credibility for the work that we do. &lt;/em&gt;&lt;/h6&gt;</intro>
    <introformat>1</introformat>
    <content>&lt;p&gt;&lt;img class="img-fluid" role="presentation" src="@@PLUGINFILE@@/Branding%20-%20Email%20Border%20%281%29.png" alt="" width="1575" height="300"&gt;&lt;/p&gt;
&lt;div class="OutlineElement Ltr SCXO106430228 BCX0"&gt;
&lt;p class="Paragraph SCXO106430228 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;To ensure consistency and clear communication to internal and external audiences, all Maine DOE staff must follow the email signature and out-of-office message guidelines below. The templates included are designed to maximize accessibility and readability for both internal and external constituents. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr SCXO106430228 BCX0"&gt;
&lt;p class="Paragraph SCXO106430228 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;strong&gt;&lt;span class="TextRun Underlined SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Email Text Guidelines&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;:&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul class="BulletListStyle1 SCXO106430228 BCX0" role="list"&gt;
&lt;li class="OutlineElement Ltr SCXO106430228 BCX0" role="listitem" data-aria-posinset="1" data-aria-level="2"&gt;
&lt;p class="Paragraph SCXO106430228 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Written/displayed in: 12pt, Calibri, Black Font&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr SCXO106430228 BCX0"&gt;
&lt;p class="Paragraph SCXO106430228 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;strong&gt;&lt;span class="TextRun Underlined SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Signature Guidelines&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;:&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li class="Paragraph SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US"&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Written/displayed in: 12pt, Calibri, Black Font&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;/li&gt;
&lt;li class="Paragraph SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US"&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Lead with the Maine Department of Education logo. You may include one additional logo for your department team.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;/li&gt;
&lt;li class="Paragraph SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US"&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Avoid additional information or text (e.g. quotes, additional information, etc.)&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;/li&gt;
&lt;li class="Paragraph SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US"&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Avoid backgrounds (e.g. images, colors, etc.)&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO106430228 BCX0"&gt; &lt;br&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr SCXO106430228 BCX0"&gt;
&lt;p class="Paragraph SCXO106430228 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;strong&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="none"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Email Signature Layout&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr SCXO106430228 BCX0"&gt;
&lt;p class="Paragraph SCXO106430228 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Name (pronouns optional)&lt;/span&gt;&lt;/span&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO106430228 BCX0"&gt;&lt;span class="SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;br class="SCXO106430228 BCX0"&gt;&lt;/span&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Title – Team (team if applicable)&lt;/span&gt;&lt;/span&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO106430228 BCX0"&gt;&lt;span class="SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;br class="SCXO106430228 BCX0"&gt;&lt;/span&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Office (if applicable)&lt;/span&gt;&lt;/span&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO106430228 BCX0"&gt;&lt;span class="SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;br class="SCXO106430228 BCX0"&gt;&lt;/span&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Maine Department of Education&lt;/span&gt;&lt;/span&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO106430228 BCX0"&gt;&lt;span class="SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;br class="SCXO106430228 BCX0"&gt;&lt;/span&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;DOE Address&lt;/span&gt;&lt;/span&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO106430228 BCX0"&gt;&lt;span class="SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;br class="SCXO106430228 BCX0"&gt;&lt;/span&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Email Address&lt;/span&gt;&lt;/span&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO106430228 BCX0"&gt;&lt;span class="SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;br class="SCXO106430228 BCX0"&gt;&lt;/span&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Phone Number&lt;/span&gt;&lt;/span&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO106430228 BCX0"&gt;&lt;span class="SCXO106430228 BCX0"&gt; &lt;/span&gt;&lt;br class="SCXO106430228 BCX0"&gt;&lt;/span&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Websites&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO106430228 BCX0"&gt; &lt;br&gt;&lt;/span&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Logo(s) (height = 0.65” / width = 1.78”)&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p class="Paragraph SCXO106430228 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;strong&gt;&lt;span class="TextRun SCXO106430228 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO106430228 BCX0"&gt;Out-of-Office Messages&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;div class="OutlineElement Ltr SCXO126182982 BCX0"&gt;
&lt;p class="Paragraph SCXO126182982 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="TextRun SCXO126182982 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO126182982 BCX0"&gt;Out-of-Office Message Guidelines and Template&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO126182982 BCX0"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr SCXO126182982 BCX0"&gt;
&lt;p class="Paragraph SCXO126182982 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="TextRun SCXO126182982 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO126182982 BCX0"&gt;If you are out of the office for time off, illness, etc., you should activate an out-of-office message through Outlook. The message should be brief. Indicate when you will return to the office, and include information about whom someone can contact in your absence. Avoid extended descriptions of why you are taking time off. Staff should not post an out-of-office message without an alternative contact to whom people can reach out. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO126182982 BCX0"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr SCXO126182982 BCX0"&gt;
&lt;p class="Paragraph SCXO126182982 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO126182982 BCX0"&gt;&lt;span class="SCXO126182982 BCX0"&gt; &lt;/span&gt;&lt;br class="SCXO126182982 BCX0"&gt;&lt;/span&gt;&lt;strong&gt;&lt;span class="TextRun Underlined SCXO126182982 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="none"&gt;&lt;span class="NormalTextRun SCXO126182982 BCX0"&gt;Out-of-Office Template&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO126182982 BCX0"&gt;&lt;br class="SCXO126182982 BCX0"&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr SCXO126182982 BCX0"&gt;
&lt;p class="Paragraph SCXO126182982 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="TextRun SCXO126182982 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="none"&gt;&lt;span class="NormalTextRun SCXO126182982 BCX0"&gt;I am out of the office and will return on [return date]&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXO126182982 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="none"&gt;&lt;span class="NormalTextRun SCXO126182982 BCX0"&gt;. I will be happy to reply to your message when I return. If you need assistance, please contact [name of colleague + their job title] at [email, phone, etc.]&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO126182982 BCX0"&gt; &lt;br&gt;&lt;/span&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO126182982 BCX0"&gt;&lt;span class="SCXO126182982 BCX0"&gt; &lt;/span&gt;&lt;br class="SCXO126182982 BCX0"&gt;&lt;/span&gt;&lt;strong&gt;&lt;span class="TextRun Underlined SCXO126182982 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="none"&gt;&lt;span class="NormalTextRun SCXO126182982 BCX0"&gt;Limited Access Template (at a conference, retreat, etc.)&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun Underlined SCXO126182982 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="none"&gt;&lt;span class="NormalTextRun SCXO126182982 BCX0"&gt; &lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span class="LineBreakBlob BlobObject DragDrop SCXO126182982 BCX0"&gt;&lt;br class="SCXO126182982 BCX0"&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr  BCX0 SCXO126182982"&gt;
&lt;p class="Paragraph SCXO126182982 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="TextRun SCXO126182982 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="none"&gt;&lt;span class="NormalTextRun SCXO126182982 BCX0"&gt;I will be out of the office from [date] to [date] and will have limited access to email during this time. &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXO126182982 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="none"&gt;&lt;span class="NormalTextRun SCXO126182982 BCX0"&gt;If your message is urgent, please contact [alternative contact information]&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXO126182982 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="none"&gt;&lt;span class="NormalTextRun SCXO126182982 BCX0"&gt;. Otherwise, I'll respond to your email as soon as I can when I return.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO126182982 BCX0"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p class="Paragraph SCXO126182982 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;strong&gt;&lt;span class="EOP SCXO126182982 BCX0"&gt;Voicemail Guidelines&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;div class="OutlineElement Ltr SCXO8524695 BCX0"&gt;
&lt;p class="Paragraph SCXO8524695 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="TextRun SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO8524695 BCX0"&gt;For consistency purposes in both internally- and externally-facing communications, all Maine Department of Education (DOE) employees are asked to include similar elements in their outgoing voicemail messages, in the case that they are not able to answer the phone. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO8524695 BCX0"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr SCXO8524695 BCX0"&gt;
&lt;p class="Paragraph SCXO8524695 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="TextRun Underlined SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO8524695 BCX0"&gt;Please refer to the following guidelines:&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO8524695 BCX0"&gt; &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO8524695 BCX0"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr SCXO8524695 BCX0"&gt;
&lt;ul&gt;
&lt;li class="Paragraph SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US"&gt;&lt;span class="TextRun SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO8524695 BCX0"&gt;Include &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO8524695 BCX0"&gt;a greeting, your name, and your title.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO8524695 BCX0"&gt; &lt;/span&gt;&lt;/li&gt;
&lt;li class="Paragraph SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US"&gt;&lt;span class="TextRun SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO8524695 BCX0"&gt;Briefly apologize for missing the call. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO8524695 BCX0"&gt; &lt;/span&gt;&lt;/li&gt;
&lt;li class="Paragraph SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US"&gt;&lt;span class="TextRun SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO8524695 BCX0"&gt;Ask for the information you require to return a call (e.g., name, number, date/time, reason for calling, etc.)&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO8524695 BCX0"&gt; &lt;/span&gt;&lt;/li&gt;
&lt;li class="Paragraph SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US"&gt;&lt;span class="TextRun SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO8524695 BCX0"&gt;Provide any other pertinent information to allow a caller to reach you. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO8524695 BCX0"&gt; &lt;/span&gt;&lt;/li&gt;
&lt;li class="Paragraph SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US"&gt;&lt;span class="TextRun SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO8524695 BCX0"&gt;Use a friendly but professional tone. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO8524695 BCX0"&gt; &lt;/span&gt;&lt;/li&gt;
&lt;li class="Paragraph SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US"&gt;&lt;span class="TextRun SCXO8524695 BCX0" lang="EN-US" xml:lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXO8524695 BCX0"&gt;Keep your message short and succinct. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXO8524695 BCX0"&gt; &lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class="OutlineElement Ltr  BCX0 SCXO8524695"&gt;
&lt;p class="Paragraph SCXO8524695 BCX0" xml:lang="EN-US" lang="EN-US"&gt;&lt;span class="EOP SCXO8524695 BCX0"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;</content>
