-uuid=\"9c5a9b14-8068-4d83-ba2a-1d97374748ac\" href=\"/doe/sites/maine.gov.doe/files/inline-files/ICC%20Meeting%20Notes%203.14.22.docx\">Meeting Notes 3.14.22</a></li>\r\n\t<li><a class=\"file file--mime-application-vnd-openxmlformats-officedocument-wordprocessingml-document file--x-office-document\" data-entity-type=\"file\" data-entity-uuid=\"06d34105-574c-420a-8adb-19ca8f569be5\" href=\"/doe/sites/maine.gov.doe/files/inline-files/ICC%20Meeting%20Notes%2012.13.21.docx\">Meeting Notes 12.13.21</a></li>\r\n\t<li><a class=\"file file--mime-application-vnd-openxmlformats-officedocument-wordprocessingml-document file--x-office-document\" data-entity-type=\"file\" data-entity-uuid=\"8d32e2b3-d313-4145-8e06-373bcd5b2327\" href=\"/doe/sites/maine.gov.doe/files/inline-files/ICC%20Meeting%20Notes%2011.15.21.docx\" title=\"Meeting Notes 11.15.21\">Meeting Notes 11.15.21</a></li>\r\n\t<li><a class=\"file file--mime-application-vnd-openxmlformats-officedocument-wordprocessingml-document file--x-office-document\" data-entity-type=\"file\" data-entity-uuid=\"19ef0f54-3016-402a-9830-17224f713b34\" href=\"/doe/sites/maine.gov.doe/files/inline-files/ICC%20Meeting%20Notes%2010.4.21.docx\" title=\"Meeting Notes 10.4.21\">Meeting Notes 10.4.21</a></li>\r\n\t<li><a class=\"file file--mime-application-vnd-openxmlformats-officedocument-wordprocessingml-document file--x-office-document\" data-entity-type=\"file\" data-entity-uuid=\"b2a77727-c6fd-4610-9e36-3c9e6a948b42\" href=\"/doe/sites/maine.gov.doe/files/inline-files/ICC%20Meeting%20Notes%207.12.21_1.docx\" title=\"Meeting Notes 7.12.21\">Meeting Notes 7.12.21</a></li>\r\n\t<li><a class=\"file file--mime-application-vnd-openxmlformats-officedocument-wordprocessingml-document file--x-office-document\" data-entity-type=\"file\" data-entity-uuid=\"aecd4c3f-1bbf-4a12-b7d2-efe514bdcc6b\" href=\"/doe/sites/maine.gov.doe/files/inline-files/ICC%20Meeting%20Agenda%204.6.21_2.docx\" title=\"Meeting Notes 4.6.21\">Meeting Notes 4.6.21</a></li>\r\