evel, so a fourth-level title inside a page that only goes to three is announced as belonging to a level that does not exist. Each is styled by its class and its position rather than its number, so nothing changes on screen.","value":"4 headings"},{"id":"eyebrow","on":true,"label":"Eyebrow: \"Transition - Young Person\"","why":"Taken from the parent page, /learning/specialed/transition/youngperson."}],"mechanical":["white-on-white text: 1","image alignment translated to the house class: 18","drupal entity attrs stripped: 53","target set by destination: 16","columns that never stack given a breakpoint: 3","trailing breaks removed from headings: 1"],"findings":[{"name":"image-alone-between-sections","n":3,"eg":["I want to continue my education.","I want to explore career opportunities."]},{"name":"card-row-holding-one-card","n":1,"eg":["a grid row with one card in it"]},{"name":"lopsided-card-row","n":1,"eg":["42 chars beside 398"]},{"name":"heading-in-all-capitals","n":1,"eg":["CONTACT:"]}],"safe":true,"audit":{"alias":"/learning/specialed/transition/youngperson/continue","title":"Transition - Continue Education","changed":"2026-04-06T23:22:53+00:00","words":176,"bytes":11947,"fixes":["white-on-white text: 1","image alignment translated to the house class: 18","drupal entity attrs stripped: 53","target set by destination: 16","columns that never stack given a breakpoint: 3","trailing breaks removed from headings: 1"],"flags":["no section-header device","h5 card titles","inline style= remains"],"contentSafe":true,"headings":[{"l":5,"t":"I want to continue my education.","bh":false},{"l":5,"t":"Trade Schools","bh":false},{"l":5,"t":"Best Trade Schools in Maine","bh":false},{"l":5,"t":"Career and Technical Education Schools","bh":false},{"l":5,"t":"Trade Schools and Online Technical Colleges","bh":false},{"l":5,"t":"Northeast Technical Institute","bh":false},{"l":5,"t":"Community Colleges","bh":false},{"l":5,"t":"Maine Community Colleges Student Support Services","bh":f