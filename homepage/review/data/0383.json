,"on":true,"label":"Write the email addresses the same way","why":"1 address is shown in whatever case it was typed in. The house form capitalises each name and leaves a middle initial in lower case — titus.orourke@maine.gov → Titus.Orourke@maine.gov. Only the first letter of each part changes, so a name that spells itself LaBreck keeps doing so.","value":"1 address"},{"id":"cardtitles","on":true,"label":"Put the card titles on one level","why":"4 card titles are written at a level copied from an example rather than chosen — h5 on a page whose sections are h2. Only the number changes.","value":"4 titles"},{"id":"buttons","on":true,"label":"Put the buttons on the house style","why":"4 buttons use a Bootstrap variant rather than btn-info, so the same kind of action is drawn three different ways across the site. Only the class changes.","value":"4 buttons"},{"id":"contacttitle","on":true,"label":"Set a job title the way the rest of the site does","why":"1 job title sits in plain text under the person's name, where 186 elsewhere on the site are in italics — so the same contact block is drawn two ways depending on the page, and the title runs into the name above it. The standard here is the site's own, not a preference: two thirds of these blocks already do it. No word changes.","value":"1 title"},{"id":"fill","on":true,"label":"Let a short row of cards reach the page edge","why":"2 rows hold cards in columns that add up to less than the full twelve, so the grid stops short and the rest of the line is blank. The cards are narrower than they need to be, which makes everything inside them taller — and the page longer. Only the column widths change.","value":"2 rows"},{"id":"banner-graphic","on":true,"label":"Retire the old banner graphic","why":"It repeats the page title in picture form, which the new banner already does in type.","removes":"Banner 1 Primary.png"},{"id":"eyebrow","on":true,"label":"Eyebrow: \"Transition\"","why":"Taken from the parent page, /learning/specialed/transition."}],"mechanical":["empty paragraphs removed: 2","image alignment translated to the house class: 4","drupal entity attrs stripped: 34","columns that never stack given a breakpoint: 5"],"findings":[{"name":"image-alone-between-sections","n":5,"eg":["Young Person","Caregiver"]}],"safe":true,"audit":{"alias":"/learning/specialed/transition/educator","title":"Transition - Educator","changed":"2026-04-06T23:22:58+00:00","words":37,"bytes":5099,"fixes":["empty paragraphs removed: 2","image alignment translated to the house class: 4","drupal entity attrs stripped: 34","columns that never stack given a breakpoint: 5"],"flags":["no section-header device","h5 card titles"],"contentSafe":true,"headings":[{"l":5,"t":"Transition Assessment Resources","bh":false},{"l":5,"t":"Transition Power Hour","bh":false},{"l":5,"t":"Professional Learning","bh":false},{"l":5,"t":"Person-Centered Planning","bh":false},{"l":3,"t":"Contact:","bh":false}],"outline":[{"i":0,"issue":"jumps h1 to h5","text":"Transition Assessment Resources"}],"components":{"cards":16,"cardHeaders":0,"cardTitles":4,"accordions":0,"tables":0,"dataTables":0,"contactCube":1,"jumbotron":0,"dcNote":0,"blockheads":0,"videos":0,"images":9,"buttons":4},"access":{"imagesNoAlt":0,"vagueLinkText":[],"emptyLinks":0,"tablesNoScope":0,"multipleH1":0,"inlineColour":0},"links":{"internal":["/doe/node/4367"],"files":[],"external":[],"mailto":["mailto:titus.orourke@maine.gov"],"safelinks":[],"anchors":[]},"age":{"changed":"2026-04-06T23:22:58+00:00","yearsMentioned":[],"newestYear":null,"yearsBehind":null,"schoolYears":[],"unfinishedPhrases":[]},"opening":null,"openingChars":0},"override":{}}