opia.org/article/engaging-students-community-based-projects\" target=\"_blank\">Engaging Students with Community-Based Practices</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"https://www.edutopia.org/blog/school-community-collaboration-brendan-okeefe\" target=\"_blank\">5 Steps to Better School/Community Collaboration</a></li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n\n<p class=\"doe-top\"><a href=\"#top\">Back to top</a></p>","notes":[],"decisions":[{"id":"deck","on":true,"label":"Use this paragraph as the page description","why":"It is the page’s own opening paragraph, moved into the banner rather than rewritten.","value":"Community connections can make learning more relevant and meaningful by helping to foster a sense of belonging, develop empathy, and link classroom experiences to the real world."},{"id":"banner-graphic","on":true,"label":"Retire the old banner graphic","why":"It repeats the page title in picture form, which the new banner already does in type.","removes":"Interdisciplinary Instruction - Community Connections Banner - 6.10.2025.png"}],"mechanical":["drupal entity attrs stripped: 2","target set by destination: 8","loose text wrapped in a paragraph: 1","images released from inline dimensions: 1","paragraph unwrapped inside a card header: 1","margin utilities removed from card headers: 1","line breaks at the edge of a block removed: 1","video wrapped: 1","action links marked: 8"],"findings":[{"name":"video-in-a-card-outside-the-top-slot","n":1,"eg":["video inside the card body"]},{"name":"card-row-holding-one-card","n":1,"eg":["a grid row with one card in it"]}],"safe":true,"audit":{"alias":"/learning/II/ConCEPT/connections","title":"Community Connections","changed":"2026-04-06T22:49:43+00:00","words":99,"bytes":3117,"fixes":["drupal entity attrs stripped: 2","target set by destination: 8","loose text wrapped in a paragraph: 1","images released from inline dimensions: 1","paragraph unwrapped inside 