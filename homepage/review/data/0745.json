rs%20%282%29.pdf","/doe/sites/maine.gov.doe/files/inline-files/McKinney-Vento%20Haitian%20Creole.pdf","/doe/sites/maine.gov.doe/files/inline-files/McKinney-Vento%20Flier-Arabic.pdf","/doe/sites/maine.gov.doe/files/inline-files/SAMPLE%20MV%20Screener.doc","/doe/sites/maine.gov.doe/files/inline-files/SAMPLE%20new%20McKinney%20Vento%20eligibility%20form.docx","/doe/sites/maine.gov.doe/files/inline-files/SAMPLE%20McKinney-Vento%20Annual%20Check-In%20Form.docx","/doe/sites/maine.gov.doe/files/inline-files/SAMPLE%20McKinney%20Vento%20Referral%20Form%20-%20District.docx","/doe/sites/maine.gov.doe/files/inline-files/sample%20transportation%20agreement%20LEA.docx","/doe/sites/maine.gov.doe/files/inline-files/McKinney-Vento%20-%20Unaccompanied%20Homeless%20Youth%20Eligibility%20Flowchart%20-%204.15.2026.pdf","https://www.maine.gov/doe/sites/maine.gov.doe/files/inline-files/Sample%20Caregiver%20Template.pdf","/doe/sites/maine.gov.doe/files/inline-files/McKinney-Vento%20-%20Maine%20Unaccompanied%20Homeless%20Youth%20Status%20Verification%20Sample%20Form%20for%20Health%20Care%20Services%20-%204.15.2026.docx","https://www.maine.gov/doe/sites/maine.gov.doe/files/inline-files/An-Interview-Checklist-For-Supporting-School-Selection-Unaccompanied-Youth.pdf"],"external":["https://forms.office.com/g/JyvAep2A7Q","http://nche.ed.gov/homeless-liaison-toolkit/","http://nche.ed.gov/wp-content/uploads/2018/10/new-liaisons.pdf","http://maine.us2.list-manage.com/subscribe?u=a582edd6473e477ef6307c769&amp;id=21283d239d","https://schoolhouseconnection.org/article/sample-form-letters-to-determine-independent-student-status-of-unaccompanied-homeless-youth-for-the-fafsa","https://www.1800runaway.org"],"mailto":["mailto:Signe.Lynch@maine.gov"],"safelinks":[],"anchors":[]},"age":{"changed":"2026-08-31T14:15:19+00:00","yearsMentioned":[],"newestYear":null,"yearsBehind":null,"schoolYears":[],"unfinishedPhrases":[]},"opening":null,"openingChars":0},"override":{}}