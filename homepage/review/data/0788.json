-files/School%20Finance%20-%20Regional%20Index%20Comparison%20by%20SAU%20-%207.15.2026.pdf\">Regional Index Comparison by SAU</a></li>\r\n\t<li class=\"doe-action\"><a href=\"https://www.maine.gov/doe/sites/maine.gov.doe/files/inline-files/School%20Finance%20-%202026%20Maine%20School%20Finance%20Handbook%20-%207.9.2026.pdf\">2026 School Finance Accounting Handbook</a></li>\r\n\t<li class=\"doe-action\"><a href=\"https://www.maine.gov/doe/sites/maine.gov.doe/files/inline-files/School%20Finance%20-%202026%20Accounting%20Handbook%20-%207.9.2026.pdf\">2026 Accounting Handbook Coding Updates</a></li>\r\n\t<li class=\"doe-action\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Finance%20-%20MaineCare%20Enrollment%20for%20FAPE%20Transition%20Cohorts%20Guidelines%20-%208.10.2026.pdf\">MaineCare Enrollment for FAPE Transition Cohorts Guidelines</a></li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n<!-- Resource cards (3-up) -->\r\n\r\n<div class=\"row justify-content-center mb-4\">\r\n<div class=\"col-sm-4 py-2\">\r\n<div class=\"card h-100\">\r\n<div class=\"card-header text-white bg-primary\"><strong>ED 279</strong></div>\r\n\r\n<div class=\"card-body text-dark\">\r\n<ul>\r\n\t<li class=\"doe-action\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Finance%20-%20Essential%20Programs%20and%20Services%20Public%20School%20Funding%20Formula%20-%20How%20it%20works%20-%209.24.2024.pdf\">Essential Programs &amp; Services: School Funding Formula</a> </li>\r\n\t<li class=\"doe-action\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/Form%20279%201%20to%205%20final.xlsx\">ED279 Form steps 1-5</a><span class=\"doe-chip\" data-src=\"file\">Excel</span> </li>\r\n\t<li class=\"doe-action\"><a href=\"https://www.youtube.com/watch?v=XX_T2qx3T70\" target=\"_blank\">EPS Funding Formula presentation from 2025 MSMA Fall Conference</a><span class=\"doe-chip\" data-src=\"file\">Video</span> </li>\r\n</ul>\r\n\r\n\r\n</div>\r\n</div>\r\n</div>\r\n\r\n<div class=