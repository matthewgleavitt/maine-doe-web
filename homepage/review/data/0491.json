%20-%20RSU%2012%20Program%20Narrative%20-%2010.31.2024.pdf"],"external":["https://www.mainelegislature.org/legis/bills/getPDF.asp?paper=HP1409&amp;item=7&amp;snum=130","https://mainedoenews.net/2024/09/18/maine-department-of-education-awards-750000-in-climate-education-professional-development-grants/","https://www.youtube.com/watch?v=Qfpeajd0i2Q"],"mailto":["mailto:theodore.lyman@maine.gov"],"safelinks":[],"anchors":[]},"age":{"changed":"2026-04-08T16:02:06+00:00","yearsMentioned":[2024,2025],"newestYear":2025,"yearsBehind":1,"schoolYears":[],"unfinishedPhrases":[]},"opening":null,"openingChars":0},"override":{}}