-type=\"file\" data-entity-uuid=\"ce9e631b-29b1-4123-bd84-077139cf51fc\" filename=\"School Safety - Cell Phone Policy Bell-to-Bell Restorative Practice Model Maine - 7.29.2026.pdf\" href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Cell%20Phone%20Policy%20Bell-to-Bell%20Restorative%20Practice%20Model%20Maine%20-%207.29.2026.pdf\">MSSC Guide &amp; Restorative Model for Maine \"Bell to Bell\" Cell/ED Policy</a></li>\r\n\t<li class=\"list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Implementation%20Guidance%20Bell-to-Bell%20Policy%20-%207.29.2026.pdf\">Maine DOE/ MSMA Implementation Guidance for Maine “Bell to Bell” Policy</a>&nbsp;</li>\r\n\t<li class=\"list-group-item\"><span style=\"font-size:12.0pt\"><span style=\"font-family:&quot;Aptos&quot;,sans-serif\"><span style=\"color:black\"><a class=\"file file--mime-application-pdf file--application-pdf\" data-entity-type=\"file\" data-entity-uuid=\"9541f89e-1109-4ece-9784-17378f8be935\" filename=\"School Safety - Verbal De-Escalation Basics - 9.9.2026.pdf\" href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Verbal%20De-Escalation%20Basics%20-%209.9.2026.pdf\">Verbal De-Escalation Basics With Restorative Skills</a></span></span></span></li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"col-sm-6 py-2\">\r\n<div class=\"card h-100\"><!-- [IMAGE_PLACEHOLDER: Resources.png — upload and replace src] -->\r\n<div class=\"card-header text-white bg-primary\"><strong>Resources</strong></div>\r\n\r\n<div class=\"card-body\">\r\n<ul class=\"list-group list-group-flush\">\r\n\t<li class=\"list-group-item\"><a class=\"file file--mime-application-pdf file--application-pdf\" data-entity-type=\"file\" data-entity-uuid=\"ba20428d-880a-4f87-aaf1-31319a26c793\" filename=\"School Safety - Restorative Practices Recommended Reading - 4.10.2026.pdf\" href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Restorative%20Practices%20Recommended%20Reading%20-%204.10.2026.pdf\">Restorative Reading: Check Out Our Booklist for Teachers, Staff &amp; Students</a></li>\r\n\t<li class=\"list-group-item\"><a class=\"file file--mime-image-png file--image\" data-entity-type=\"file\" data-entity-uuid=\"292dc2c5-d208-4bb4-933a-d7caa3e5b37b\" filename=\"School Safety - Childrens Advocacy Centers - 4.10,2026.png\" href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Childrens%20Advocacy%20Centers%20-%204.10%2C2026.png\">Child Advocacy Centers in Maine</a>&nbsp;</li>\r\n\t<li class=\"list-group-item\"><a class=\"file file--mime-image-png file--image\" data-entity-type=\"file\" data-entity-uuid=\"28908fa2-b853-41fc-9fac-4dd575cbf4d1\" filename=\"School Safety - Sexual Assault Support Centers - 4.10.2026.png\" href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Sexual%20Assault%20Support%20Centers%20-%204.10.2026.png\">Sexual Assault &amp; Sexual Violence Support in Maine</a>&nbsp;</li>\r\n\t<li class=\"list-group-item\"><a class=\"file file--mime-application-pdf file--application-pdf\" data-entity-type=\"file\" data-entity-uuid=\"0ff6eec5-4fc6-462c-a14d-6b7042bdb8f6\" filename=\"School Safety - Restorative Practices Evidence Schools - 4.14.2026.pdf\" href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Restorative%20Practices%20Evidence%20Schools%20-%204.14.2026.pdf\">Restorative Practices in Schools: The Evidence</a></li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<!-- ROW 3: Collegial Relationships (single card, centered) -->\r\n\r\n<div class=\"row justify-content-center\">\r\n<div class=\"col-sm-6 py-2\">\r\n<div class=\"card h-100\"><!-- [IMAGE_PLACEHOLDER: Collegial.png — upload and replace src] -->\r\n<div class=\"card-header text-white bg-primary\"><strong>Collegial Relationships</strong></div>\r\n\r\n<div class=\"card-body\">\r\n<ul class=\"list-group list-group-flush\">\r\n\t<li class=\"list-group-item\"><a class=\"file file--mime-application-pdf file--application-pdf\" data-entity-type=\"file\" data-entity-uuid=\"e155affb-8f30-4826-941a-e20448739fef\" filename=\"School Safety - Mindful Activities with Colleagues - 4.10.2026.pdf\" href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Mindful%20Activities%20with%20Colleagues%20-%204.10.2026.pdf\">Build Rapport Amongst Colleagues with These Mindful Activities</a></li>\r\n\t<!-- TODO: \"Andrews reccos?\" — awaiting final content from Dr. Gulley-Vernon -->\r\n\t<li class=\"list-group-item\">\r\n\t<p><a data-entity-type=\"file\" data-entity-uuid=\"57ac45f6-8da7-407c-aaf2-5d175cb1b6b7\" filename=\"School Safety - Collegial Relationship Building Skills &amp; Relationships Tips Exercises - 7.29.2026.pdf\" href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Collegial%20Relationship%20Building%20Skills%20%26%20Relationships%20Tips%20Exercises%20-%207.29.2026.pdf\">Doing \"The Practice\" - Building Skills &amp; Relationships Amongst Staff&nbsp;&nbsp;</a></p>\r\n\t</li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<!-- ============================\r\n     SURVEY CTA\r\n     ============================ -->\r\n\r\n<div class=\"blockhead\">\r\n<h2>Share Your Feedback</h2>\r\n</div>\r\n\r\n<div class=\"dc-note text-center\">\r\n<p>Feedback is important in shaping the resource offerings on this site. Please take a moment to share thoughts in this brief anonymous survey. Thank you!</p>\r\n\r\n<p><a class=\"btn btn-info btn-lg\" href=\"https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=q6g_QX0gYkubzeoajy-GTi_yRB42TAdIuW9gxN6kx05UNUpOTktPNzZCWjRTTkJWVkJXTVdWVUdEMy4u\" target=\"_blank\">Take the Survey</a></p>\r\n</div>\r\n<!-- ============================\r\n     CONTACT\r\n     ============================ -->\r\n\r\n<div class=\"contact-cube\">\r\n<h3><strong>For More Information</strong></h3>\r\n\r\n<p><strong>Dr. Stacey Gulley-Vernon</strong><br />\r\n<em>Restorative Practices Coordinator</em><br />\r\n<strong>Phone:</strong> 207-446-8313<br />\r\n<strong>Email:</strong> <a href=\"mailto:Stacey.Gulley-Vernon@Maine.Gov\">Stacey.Gulley-Vernon@Maine.Gov</a></p>\r\n</div>\r\n","after":"<div class=\"doe-hero\">\n<p class=\"doe-eyebrow\">Restorative Practices</p>\n<p class=\"doe-contact-link\"><a href=\"#contact\">Contact</a></p>\n<nav class=\"doe-toc\"><h3>On this page</h3><ol><li><a href=\"#creating-a-culture-of-care-in-schools-using-rest\">Creating a Culture of Care in Schools Using Restorative Practices</a></li><li><a href=\"#restorative-practices-resources\">Restorative Practices Resources</a></li><li><a href=\"#share-your-feedback\">Share Your Feedback</a></li></ol></nav>\n</div>\n\r\n\r\n<div class=\"rp-masthead text-center\">\r\n<div class=\"container\">\r\n<p><!-- [IMAGE_PLACEHOLDER: MSSC/DOE Logo — upload and replace src] --></p>\r\n\r\n<div class=\"blockhead\" id=\"creating-a-culture-of-care-in-schools-using-rest\">\n<h2>Creating a Culture of Care in Schools Using Restorative Practices</h2>\n</div>\r\n</div>\r\n</div>\r\n<!-- HERO SECTION -->\r\n\r\n<div class=\"rp-hero\">\r\n<div class=\"row align-items-center\">\r\n<div class=\"col-md-5 py-2 text-center\"><!-- [IMAGE_PLACEHOLDER: Peer-Circle-Hero.png — upload and replace src] --><img alt=\"Students and staff sitting together in a peer circle\" class=\"img-fluid rounded\" src=\"/doe/sites/maine.gov.doe/files/inline-images/School%20Safety%20-%20Culture%20of%20Care%20Intro%20-%206.1.2026.png\" /></div>\r\n\r\n<div class=\"col-md-7 py-2\">\r\n<p>Welcome to the <em>Creating a Culture of Care in Schools Using Restorative Practices</em> Resource Center — a collection of supplementary materials for educators who have completed the training. Included are additional resources to support schools across Maine as they expand environments of safety and mattering for staff and students, as well as connections to community partners that can help with some of the trickiest challenges.</p>\r\n\r\n<p>All materials are currently available as downloadable PDFs. The goal is to continue developing and expanding the resources offered here and to grow a new Community of Practice in Maine. Feedback is important for shaping what is included — please take a moment to share thoughts in the anonymous survey below.</p>\r\n\r\n<p>Thank you for all you do for the students of Maine!</p>\r\n\r\n<p><strong>Dr. Stacey Gulley-Vernon</strong><br />\r\nRestorative Practices Coordinator, Maine School Safety Center</p>\r\n</div>\r\n</div>\r\n</div>\r\n<!-- ============================\r\n     CONTENT PILLARS (CARDS)\r\n     ============================ --><!-- ROW 1: Curriculum + Community Building -->\r\n\r\n<div class=\"blockhead\" id=\"restorative-practices-resources\">\r\n<h2>Restorative Practices Resources</h2>\r\n</div>\r\n\r\n<div class=\"row\">\r\n<div class=\"col-sm-6 py-2\">\r\n<div class=\"card h-100\"><!-- [IMAGE_PLACEHOLDER: Curriculum.png — upload and replace src] -->\r\n<div class=\"card-header text-white bg-primary\"><strong>Curriculum</strong></div>\r\n\r\n<div class=\"card-body\">\r\n<ul class=\"list-group list-group-flush\">\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Restorative%20Practices%20PreK%20Elementary%20Student%20Curriculum%20-%206.4.2026.pdf\">Pre-K–Elementary Student Curriculum for Teachers</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Restorative%20Practices%20Middle%20School%20Curriculum%20-%206.10.2026.pdf\">Middle School Student Curriculum for Teachers</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Restorative%20Practices%20High%20School%20Student%20Curriculum%20-%206.9.2026.pdf\">High School Student Curriculum for Teachers</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Final%20School%20Staff%20Training%20Workbook%20-%204.10.2026.pdf\">Downloadable CCC Staff Workbooks</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Final%20Implementation%20Team%20Training%20Workbook%20-%204.16.2026.pdf\">Downloadable CCC IT Workbooks</a></li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"col-sm-6 py-2\">\r\n<div class=\"card h-100\"><!-- [IMAGE_PLACEHOLDER: Community.png — upload and replace src] -->\r\n<div class=\"card-header text-white bg-primary\"><strong>Community Building</strong></div>\r\n\r\n<div class=\"card-body\">\r\n<ul class=\"list-group list-group-flush\">\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20PreK-Elementary%20Mindfulness%20Activities%20-%204.10.2026.pdf\">Pre-K–Elementary Mindfulness Activities</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Middle%20High%20Mindfulness%20Activities%20-%204.10.2026.pdf\">Middle / High School Mindfulness Activities</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Additional%20Community%20Prompts%20Circle%20Ideas%20-%204.10.2026.pdf\">110 Circle Questions</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Integrating%20Circles%20into%20Morning%20Meeting%20Responsive%20Classroom%20-%209.15.2026.pdf\">How to Fold the Relational Depth of the Circle Process into the Rhythm of a Responsive Classroom Morning Meeting:&nbsp; One Unified, Restorative Start to Your Day</a></li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<!-- ROW 2: Behavior + Resources -->\r\n\r\n<div class=\"row\">\r\n<div class=\"col-sm-6 py-2\">\r\n<div class=\"card h-100\"><!-- [IMAGE_PLACEHOLDER: Behavior.png — upload and replace src] -->\r\n<div class=\"card-header text-white bg-primary\"><strong>Behavior</strong></div>\r\n\r\n<div class=\"card-body\">\r\n<ul class=\"list-group list-group-flush\">\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Building%20a%20Code%20of%20Conduct%20-%204.10.2026.pdf\">Including RP in Your Code of Conduct</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Mapping%20District%20Policy%20Statutory%20Definitions%20-%204.10.2026.pdf\">Mapping Maine Statutes to District Policy Language</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Statutory%20Language%20Plain%20Language%20Restorative%20Examples%20-%204.14.2026.pdf\">Understanding \"Positive Interventions\" &amp; \"Restorative Interventions\" in Maine Statute</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Youth%20Vaping%20Restorative%20Approach%20Policy%20-%204.14.2026.pdf\">Youth Vaping &amp; Building Your Restorative Vaping Policy</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Cell%20Phone%20Policy%20Bell-to-Bell%20Restorative%20Practice%20Model%20Maine%20-%207.29.2026.pdf\">MSSC Guide &amp; Restorative Model for Maine \"Bell to Bell\" Cell/ED Policy</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Implementation%20Guidance%20Bell-to-Bell%20Policy%20-%207.29.2026.pdf\">Maine DOE/ MSMA Implementation Guidance for Maine “Bell to Bell” Policy</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Verbal%20De-Escalation%20Basics%20-%209.9.2026.pdf\">Verbal De-Escalation Basics With Restorative Skills</a></li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"col-sm-6 py-2\">\r\n<div class=\"card h-100\"><!-- [IMAGE_PLACEHOLDER: Resources.png — upload and replace src] -->\r\n<div class=\"card-header text-white bg-primary\"><strong>Resources</strong></div>\r\n\r\n<div class=\"card-body\">\r\n<ul class=\"list-group list-group-flush\">\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Restorative%20Practices%20Recommended%20Reading%20-%204.10.2026.pdf\">Restorative Reading: Check Out Our Booklist for Teachers, Staff &amp; Students</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Childrens%20Advocacy%20Centers%20-%204.10%2C2026.png\">Child Advocacy Centers in Maine</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Sexual%20Assault%20Support%20Centers%20-%204.10.2026.png\">Sexual Assault &amp; Sexual Violence Support in Maine</a></li>\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Restorative%20Practices%20Evidence%20Schools%20-%204.14.2026.pdf\">Restorative Practices in Schools: The Evidence</a></li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<!-- ROW 3: Collegial Relationships (single card, centered) -->\r\n\r\n<div class=\"row justify-content-center\">\r\n<div class=\"col-sm-12 py-2\">\r\n<div class=\"card h-100\"><!-- [IMAGE_PLACEHOLDER: Collegial.png — upload and replace src] -->\r\n<div class=\"card-header text-white bg-primary\"><strong>Collegial Relationships</strong></div>\r\n\r\n<div class=\"card-body\">\r\n<ul class=\"list-group list-group-flush\">\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Mindful%20Activities%20with%20Colleagues%20-%204.10.2026.pdf\">Build Rapport Amongst Colleagues with These Mindful Activities</a></li>\r\n\t<!-- TODO: \"Andrews reccos?\" — awaiting final content from Dr. Gulley-Vernon -->\r\n\t<li class=\"doe-action list-group-item\"><a href=\"/doe/sites/maine.gov.doe/files/inline-files/School%20Safety%20-%20Collegial%20Relationship%20Building%20Skills%20%26%20Relationships%20Tips%20Exercises%20-%207.29.2026.pdf\">Doing \"The Practice\" - Building Skills &amp; Relationships Amongst Staff</a>&nbsp;&nbsp;</li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<!-- ============================\r\n     SURVEY CTA\r\n     ============================ -->\r\n\r\n<div class=\"blockhead\" id=\"share-your-feedback\">\r\n<h2>Share Your Feedback</h2>\r\n</div>\r\n\r\n<div class=\"dc-note text-center\">\r\n<p>Feedback is important in shaping the resource offerings on this site. Please take a moment to share thoughts in this brief anonymous survey. Thank you!</p>\r\n\r\n<p><a class=\"btn btn-info btn-lg\" href=\"https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=q6g_QX0gYkubzeoajy-GTi_yRB42TAdIuW9gxN6kx05UNUpOTktPNzZCWjRTTkJWVkJXTVdWVUdEMy4u\" target=\"_blank\">Take the Survey</a></p>\r\n</div>\r\n<!-- ============================\r\n     CONTACT\r\n     ============================ -->\r\n\r\n<div id=\"contact\" class=\"contact-cube\">\r\n<h3>For More Information</h3>\r\n\r\n<p><strong>Dr. Stacey Gulley-Vernon</strong><br />\r\n<em>Restorative Practices Coordinator</em><br />\r\n<strong>Phone:</strong> 207-446-8313<br />\r\n<strong>Email:</strong> <a href=\"mailto:Stacey.Gulley-Vernon@Maine.Gov\">Stacey.Gulley-Vernon@maine.gov</a></p>\r\n</div>\r\n\n<p class=\"doe-jump\"><a href=\"#contact\">Contact</a></p>\n<p class=\"doe-top\"><a href=\"#top\">Back to top</a></p>","notes":[],"decisions":[{"id":"emailcase","on":true,"label":"Write the email addresses the same way","why":"1 address is shown in whatever case it was typed in. The house form capitalises each name and leaves a middle initial in lower case — Stacey.Gulley-Vernon@Maine.Gov → Stacey.Gulley-Vernon@maine.gov. Only the first letter of each part changes, so a name that spells itself LaBreck keeps doing so.","value":"1 address"},{"id":"solo","on":true,"label":"Let a lone card use the full width","why":"1 row holds a single card in a part-width column, so it takes a third or a half of the page and the rest is blank. A row of one is not a grid.","value":"1 card"},{"id":"banner-graphic","on":true,"label":"Retire the old banner graphic","why":"It repeats the page title in picture form, which the new banner already does in type.","removes":"School Safety - Culture of Care Banner - 6.10.2026.png"},{"id":"toc","on":true,"label":"Add a contents list (3 sections)","why":"Built from the section headings already on the page. Below three sections a list is not a route."},{"id":"eyebrow","on":true,"label":"Eyebrow: \"Restorative Practices\"","why":"Taken from the parent page, /safety/restorative."}],"mechanical":["drupal entity attrs stripped: 84","target set by destination: 1","inline layout styles stripped: 4","default-value styles dropped: 2","hard spaces at the edge of a list item removed: 3","paragraph inside a list item unwrapped: 1","loose text wrapped in a paragraph: 5","style attributes that declare nothing removed: 2","redundant bold inside a heading removed: 1","paragraph unwrapped inside a card header: 5","bare spans unwrapped: 6","body h1 to blockhead h2: 1","action links marked: 22","space moved out of a link: 1"],"findings":[{"name":"image-alone-between-sections","n":1,"eg":["Students and staff sitting together in a peer circle"]},{"name":"empty-paragraph","n":1,"eg":["(empty)"]},{"name":"card-row-holding-one-card","n":1,"eg":["a grid row with one card in it"]}],"safe":true,"audit":{"alias":"/safety/restorative/resourcecenter","title":"Culture of Care Resource Center","changed":"2026-09-15T15:51:48+00:00","words":372,"bytes":15343